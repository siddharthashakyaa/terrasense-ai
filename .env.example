# =============================================================================
# TerraSense AI - Environment Configuration Template
# Copy this file to `.env` in the project root (used by docker-compose) and
# adjust values as needed. For running the backend/frontend outside Docker,
# copy the relevant variables into backend/.env and frontend/.env.local.
# =============================================================================

# ---- PostgreSQL ----
POSTGRES_USER=terrasense
POSTGRES_PASSWORD=terrasense
POSTGRES_DB=terrasense
POSTGRES_PORT=5432

# Full SQLAlchemy connection string used by the backend
DATABASE_URL=postgresql+psycopg2://terrasense:terrasense@db:5432/terrasense

# ---- Backend (FastAPI) ----
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# ---- ML ----
MODEL_DIR=app/models
DATA_DIR=data
RANDOM_STATE=42

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_PORT=3000
